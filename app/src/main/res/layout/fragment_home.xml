<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context="Fragment.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================= HOME TOOLBAR ================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <!-- HealthConnect Logo -->
                    <ImageView
                        android:id="@+id/ivHomeLogo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="HealthConnect Logo"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_launcher" />

                    <!-- App Name -->
                    <TextView
                        android:id="@+id/tvHomeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_extrabold"
                        android:text="HealthConnect"
                        android:textColor="#3E8E32"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Notification -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardNotification"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="#F5FAF3"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:id="@+id/ivNotification"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Notifications"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/notification_icon" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================= YOUR EXISTING 700+ LINES ================= -->

            <SearchView
                android:id="@+id/svSearchFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10sp"
                android:background="@drawable/shape_background1"
                android:layout_marginTop="20dp"
                android:iconifiedByDefault="false"
                android:queryHint="Search For Health,Campus,Hospital..."

                />

            <!-- 2. Categories Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="24dp">

                <!-- Dental Category -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/tooth_svgrepo_com"
                        android:background="#E0F7FA"
                        android:scaleType="centerInside"
                        android:layout_gravity="center"/>

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teeth"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"/>
                </LinearLayout>


                <!-- Eye Category -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/eyecolor_img"
                        android:background="#CBCFE4"
                        android:scaleType="centerInside"
                        android:layout_gravity="center"/>

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eye"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/heart_img"
                        android:background="#CBCFE4"
                        android:scaleType="centerInside"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"/>
                </LinearLayout>


                <!-- Vaccine Category -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/general_img"
                        android:background="#CBCFE4"
                        android:scaleType="centerInside"
                        android:layout_gravity="center"/>

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"/>
                </LinearLayout>




            </LinearLayout>

            <!-- 3. Nearby Camps Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Camps"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textColor="#00796B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

            <!-- Nearby Camps Horizontal List Placeholder -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">




                    <!-- Card 1 -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:layout_margin="4dp">

                        <!-- Image Frame Placeholder -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:background="@drawable/hospital1_img">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[1.2 km]"
                                android:background="#A6050505"
                                android:textColor="#FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"

                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:background="@drawable/hospital1_img">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|top"
                                    android:layout_margin="8dp"
                                    android:background="#A6050505"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:text="[1.2 km]"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />
                            </FrameLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City General Health Drive Hospital"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pune, Maharashtra , India"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="General"
                                    android:background="#E0F2F1"
                                    android:textColor="#00796B"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    />


                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>



                    <!-- Card 2 -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:layout_margin="4dp">

                        <!-- Image Frame Placeholder -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:background="@drawable/hospital2_img">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[17.2 km]"
                                android:background="#A6050505"
                                android:textColor="#FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"

                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:textSize="12sp"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Government Hospital Mumbai "
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thane, Maharashtra, India"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="General"
                                    android:background="#E0F2F1"
                                    android:textColor="#00796B"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    />






                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>


                    <!-- Card 1 -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:layout_margin="4dp">

                        <!-- Image Frame Placeholder -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:background="@drawable/hospital3_img">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[2.2 km]"
                                android:background="#A6050505"
                                android:textColor="#FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"

                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:textSize="12sp"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chattrapati Shivaji Maharaj Hospital "
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shivaji Nagar , Pune, India"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Eyes , Heart Specialist"
                                    android:background="#E0F2F1"
                                    android:textColor="#00796B"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>


                    <!-- Card 1 -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:layout_margin="4dp">

                        <!-- Image Frame Placeholder -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:background="@drawable/hospial4_img">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[3.9 km]"
                                android:background="#A6050505"
                                android:textColor="#FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"

                                android:layout_gravity="end|top"
                                android:layout_margin="8dp"
                                android:textSize="12sp"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agrawal Hospital Of Teeth "
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pimpri-Chinchawad, Pune , India"
                                android:textColor="#757575"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Teeth Sepcialist"
                                    android:background="#E0F2F1"
                                    android:textColor="#00796B"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F0FDF4">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="16dp"
                    app:cardCornerRadius="12dp"
                    android:layout_margin="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/card2_img" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="Your Health, Our Priority"
                            android:textColor="#1E293B"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="Take a Step Toward Healthier you. Find Free Health Camps And Checkups Near You."
                            android:textColor="#787B7E"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F0FDF4"
                    android:padding="8dp">

                    <!-- Card 1 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#ECFDF5">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="25+"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#0F766E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New Campus In This Month"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#334155" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 2 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#F0FDFA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5K+"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#14B8A6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="People Benefited"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#334155" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 3 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        android:backgroundTint="#F0FDF4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#00FFA6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free Health Campus"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#334155" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/chatgpt"
        android:backgroundTint="#195407"
        app:maxImageSize="40dp"
        app:tint="@android:color/white" />
</FrameLayout>